APP_NAME=talentpage-api
APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s

DATABASE_DSN=postgres://talentpage:talentpage@localhost:5432/talentpage?sslmode=disable

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

STORAGE_ENDPOINT=127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=talentpage-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_USE_SSL=false

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-chat
AI_PROMPT_VERSION=profile-v1
AI_TIMEOUT=30s
AI_MAX_RETRIES=2
